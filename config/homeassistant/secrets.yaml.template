# Home Assistant Secrets Template
# Copy this to /config/secrets.yaml and fill in your values

# SureFlap Configuration
# Find your flap ID in the SureFlap web interface URL
sureflap_flap_id: "123456"

# Google Nest SDM API
nest_client_id: "your-client-id.apps.googleusercontent.com"
nest_client_secret: "GOCSPX-your-client-secret"
nest_project_id: "your-device-access-project-id"

# MQTT (if using authentication)
mqtt_user: "homeassistant"
mqtt_password: "your-mqtt-password"

# Notifications
telegram_bot_token: "your-telegram-bot-token"
telegram_chat_id: "your-chat-id"
