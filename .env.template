# CatMouse.AI Environment Configuration Template
# Copy this file to .env and fill in your secrets

# Vision AI Provider: gemini | ollama | dummy
DETECTION_PROVIDER=gemini

# Google Gemini API Key (obtain from https://aistudio.google.com/)
GEMINI_API_KEY=

# MQTT Broker IP or hostname (e.g. 192.168.1.X or homeassistant.local)
MQTT_BROKER=192.168.1.X
MQTT_PORT=1883
MQTT_USER=
MQTT_PASSWORD=

# Bridge HTTP Webhook Server
SERVER_PORT=8095

# Minimum confidence (0.0 to 1.0) to declare prey detected and lock flap
CONFIDENCE_THRESHOLD=0.7
