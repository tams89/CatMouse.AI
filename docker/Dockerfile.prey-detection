FROM python:3.11-slim

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y \
    git \
    libgl1-mesa-glx \
    libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

# Clone BalrogCatPreyAnalyzer
RUN git clone https://github.com/dieriver/BalrogCatPreyAnalyzer.git /app/analyzer

# Install Python dependencies
COPY config/prey_detection_bridge.py /app/
RUN pip install --no-cache-dir \
    paho-mqtt \
    requests \
    pyyaml \
    tensorflow \
    opencv-python-headless \
    numpy

# Copy configuration
COPY config/prey_detection_config.yaml /app/config.yaml

# Run the bridge
CMD ["python", "/app/prey_detection_bridge.py"]
